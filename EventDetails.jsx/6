import React, { useState, useEffect } from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import {
  Calendar,
  MapPin,
  Clock,
  Users,
  Ticket,
  CreditCard,
  Shield,
  AlertCircle,
  CheckCircle,
  Loader,
  Heart,
  Share2,
  ChevronLeft,
  Star
} from 'lucide-react';

const EventDetails = () => {
  const { id } = useParams();
  const navigate = useNavigate();
  const [event, setEvent] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [selectedTickets, setSelectedTickets] = useState({});
  const [isBooking, setIsBooking] = useState(false);
  const [bookingSuccess, setBookingSuccess] = useState(false);
  const [quantity, setQuantity] = useState(1);
  const [activeImage, setActiveImage] = useState(0);

  // Fetch event data
  useEffect(() => {
    const fetchEvent = async () => {
      try {
        setLoading(true);
        // Replace with your actual API call
        const response = await fetch(`/api/events/${id}`);
        if (!response.ok) throw new Error('Event not found');
        const data = await response.json();
        setEvent(data);
      } catch (err) {
        setError(err.message);
      } finally {
        setLoading(false);
      }
    };

    fetchEvent();
  }, [id]);

  const handleTicketSelection = (ticketTypeId, price) => {
    setSelectedTickets(prev => ({
      ...prev,
      [ticketTypeId]: {
        quantity,
        price
      }
    }));
  };

  const handleBooking = async () => {
    if (Object.keys(selectedTickets).length === 0) {
      alert('Please select at least one ticket');
      return;
    }

    setIsBooking(true);
    try {
      // Replace with your actual booking API call
      const response = await fetch('/api/bookings', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          eventId: id,
          tickets: selectedTickets,
          userId: 'user-id-from-auth' // Get from auth context
        }),
      });

      if (!response.ok) throw new Error('Booking failed');

      setBookingSuccess(true);
      setTimeout(() => {
        navigate('/my-tickets');
      }, 2000);
    } catch (err) {
      alert(err.message);
    } finally {
      setIsBooking(false);
    }
  };

  const getTotalPrice = () => {
    return Object.values(selectedTickets).reduce(
      (total, ticket) => total + (ticket.price * ticket.quantity),
      0
    );
  };

  if (loading) {
    return (
      <div className="min-h-screen bg-gray-50 flex items-center justify-center">
        <div className="text-center">
          <Loader className="w-12 h-12 animate-spin text-purple-600 mx-auto mb-4" />
          <p className="text-gray-600">Loading event details...</p>
        </div>
      </div>
    );
  }

  if (error || !event) {
    return (
      <div className="min-h-screen bg-gray-50 flex items-center justify-center">
        <div className="text-center">
          <AlertCircle className="w-16 h-16 text-red-500 mx-auto mb-4" />
          <h2 className="text-2xl font-bold text-gray-800 mb-2">Event Not Found</h2>
          <p className="text-gray-600 mb-4">{error || "The event you're looking for doesn't exist."}</p>
          <button
            onClick={() => navigate('/events')}
            className="px-6 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition"
          >
            Browse Events
          </button>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gray-50">
      {/* Header with back button */}
      <div className="bg-white shadow-sm sticky top-0 z-10">
        <div className="max-w-7xl mx-auto px-4 py-4">
          <button
            onClick={() => navigate(-1)}
            className="flex items-center text-gray-600 hover:text-purple-600 transition"
          >
            <ChevronLeft className="w-5 h-5 mr-1" />
            Back
          </button>
        </div>
      </div>

      <div className="max-w-7xl mx-auto px-4 py-8">
        <div className="grid lg:grid-cols-3 gap-8">
          {/* Left Column - Event Info */}
          <div className="lg:col-span-2 space-y-6">
            {/* Image Gallery */}
            <div className="bg-white rounded-xl shadow-sm overflow-hidden">
              <div className="relative h-96">
                <img
                  src={event.images?.[activeImage] || event.imageUrl || '/api/placeholder/800/400'}
                  alt={event.title}
                  className="w-full h-full object-cover"
                />
                <button className="absolute top-4 right-4 p-2 bg-white rounded-full shadow-md hover:bg-gray-100">
                  <Heart className="w-5 h-5 text-gray-600" />
                </button>
                <button className="absolute top-4 right-16 p-2 bg-white rounded-full shadow-md hover:bg-gray-100">
                  <Share2 className="w-5 h-5 text-gray-600" />
                </button>
              </div>
              {event.images && event.images.length > 1 && (
                <div className="flex gap-2 p-4 overflow-x-auto">
                  {event.images.map((img, idx) => (
                    <button
                      key={idx}
                      onClick={() => setActiveImage(idx)}
                      className={`w-20 h-20 rounded-lg overflow-hidden border-2 transition ${
                        activeImage === idx ? 'border-purple-600' : 'border-transparent'
                      }`}
                    >
                      <img src={img} alt={`Event ${idx + 1}`} className="w-full h-full object-cover" />
                    </button>
                  ))}
                </div>
              )}
            </div>

            {/* Event Details */}
            <div className="bg-white rounded-xl shadow-sm p-6">
              <h1 className="text-3xl font-bold text-gray-900 mb-4">{event.title}</h1>
              
              <div className="flex items-center gap-4 mb-4">
                {event.rating && (
                  <div className="flex items-center">
                    <Star className="w-5 h-5 text-yellow-400 fill-current" />
                    <span className="ml-1 font-semibold">{event.rating}</span>
                    <span className="text-gray-500 ml-1">({event.reviews} reviews)</span>
                  </div>
                )}
                <span className={`px-3 py-1 rounded-full text-sm font-medium ${
                  event.availability ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'
                }`}>
                  {event.availability ? 'Available' : 'Sold Out'}
                </span>
              </div>

              <div className="space-y-3 mb-6">
                <div className="flex items-start">
                  <Calendar className="w-5 h-5 text-purple-600 mt-0.5 mr-3" />
                  <div>
                    <p className="font-medium text-gray-900">Date & Time</p>
                    <p className="text-gray-600">
                      {new Date(event.date).toLocaleDateString('en-US', {
                        weekday: 'long',
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                      })}
                    </p>
                    <p className="text-gray-600">{event.time}</p>
                  </div>
                </div>

                <div className="flex items-start">
                  <MapPin className="w-5 h-5 text-purple-600 mt-0.5 mr-3" />
                  <div>
                    <p className="font-medium text-gray-900">Venue</p>
                    <p className="text-gray-600">{event.venue}</p>
                    <p className="text-gray-500 text-sm">{event.address}</p>
                  </div>
                </div>

                <div className="flex items-start">
                  <Clock className="w-5 h-5 text-purple-600 mt-0.5 mr-3" />
                  <div>
                    <p className="font-medium text-gray-900">Duration</p>
                    <p className="text-gray-600">{event.duration || '2 hours'}</p>
                  </div>
                </div>

                <div className="flex items-start">
                  <Users className="w-5 h-5 text-purple-600 mt-0.5 mr-3" />
                  <div>
                    <p className="font-medium text-gray-900">Organizer</p>
                    <p className="text-gray-600">{event.organizer || 'Event Organizer'}</p>
                  </div>
                </div>
              </div>

              <div className="border-t pt-6">
                <h2 className="text-xl font-semibold mb-3">About This Event</h2>
                <p className="text-gray-600 leading-relaxed">{event.description}</p>
              </div>
            </div>
          </div>

          {/* Right Column - Ticket Booking */}
          <div className="lg:col-span-1">
            <div className="bg-white rounded-xl shadow-sm p-6 sticky top-24">
              <h2 className="text-2xl font-bold text-gray-900 mb-4">Get Your Tickets</h2>
              
              {bookingSuccess ? (
                <div className="text-center py-8">
                  <CheckCircle className="w-16 h-16 text-green-500 mx-auto mb-4" />
                  <h3 className="text-xl font-semibold mb-2">Booking Successful!</h3>
                  <p className="text-gray-600">Redirecting to your tickets...</p>
                </div>
              ) : (
                <>
                  {/* Ticket Types */}
                  <div className="space-y-4 mb-6">
                    <h3 className="font-semibold text-gray-900">Select Ticket Type</h3>
                    {event.ticketTypes?.map((ticket) => (
                      <div key={ticket.id} className="border rounded-lg p-4 hover:border-purple-300 transition">
                        <div className="flex justify-between items-start mb-3">
                          <div>
                            <h4 className="font-semibold">{ticket.name}</h4>
                            <p className="text-sm text-gray-600">{ticket.description}</p>
                          </div>
                          <div className="text-right">
                            <p className="text-2xl font-bold text-purple-600">${ticket.price}</p>
                            <p className="text-xs text-gray-500">per ticket</p>
                          </div>
                        </div>
                        
                        <div className="flex items-center justify-between">
                          <div className="flex items-center gap-3">
                            <button
                              onClick={() => setQuantity(Math.max(1, quantity - 1))}
                              className="w-8 h-8 rounded-full border border-gray-300 flex items-center justify-center hover:border-purple-600"
                            >
                              -
                            </button>
                            <span className="font-medium min-w-[40px] text-center">{quantity}</span>
                            <button
                              onClick={() => setQuantity(Math.min(ticket.maxPerOrder || 10, quantity + 1))}
                              className="w-8 h-8 rounded-full border border-gray-300 flex items-center justify-center hover:border-purple-600"
                            >
                              +
                            </button>
                          </div>
                          <button
                            onClick={() => handleTicketSelection(ticket.id, ticket.price)}
                            className="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition text-sm"
                          >
                            Select
                          </button>
                        </div>
                      </div>
                    ))}
                  </div>

                  {/* Selected Tickets Summary */}
                  {Object.keys(selectedTickets).length > 0 && (
                    <div className="border-t pt-4 mb-6">
                      <h3 className="font-semibold mb-3">Your Selection</h3>
                      {Object.entries(selectedTickets).map(([id, ticket]) => (
                        <div key={id} className="flex justify-between text-sm mb-2">
                          <span>Ticket x {ticket.quantity}</span>
                          <span>${ticket.price * ticket.quantity}</span>
                        </div>
                      ))}
                      <div className="border-t pt-2 mt-2">
                        <div className="flex justify-between font-semibold">
                          <span>Total</span>
                          <span className="text-xl text-purple-600">${getTotalPrice()}</span>
                        </div>
                      </div>
                    </div>
                  )}

                  {/* Booking Button */}
                  <button
                    onClick={handleBooking}
                    disabled={isBooking || Object.keys(selectedTickets).length === 0}
                    className="w-full py-3 bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-lg font-semibold hover:shadow-lg transition disabled:opacity-50 disabled:cursor-not-allowed"
                  >
                    {isBooking ? (
                      <span className="flex items-center justify-center">
                        <Loader className="w-5 h-5 animate-spin mr-2" />
                        Processing...
                      </span>
                    ) : (
                      <span className="flex items-center justify-center">
                        <Ticket className="w-5 h-5 mr-2" />
                        Book Now
                      </span>
                    )}
                  </button>

                  <div className="mt-4 flex items-center justify-center gap-2 text-xs text-gray-500">
                    <Shield className="w-4 h-4" />
                    <span>Secure booking guaranteed</span>
                    <CreditCard className="w-4 h-4 ml-2" />
                    <span>Multiple payment methods</span>
                  </div>
                </>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

export default EventDetails;
